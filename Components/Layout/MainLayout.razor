@using MudBlazor
@inherits LayoutComponentBase

<MudThemeProvider />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<FluentLayout>
    <FluentHeader Class="site-header">
        Compendium
    </FluentHeader>
    <FluentStack Class="main" Orientation="Microsoft.FluentUI.AspNetCore.Components.Orientation.Horizontal"
                 Width="100%">
        <NavMenu />
        <FluentBodyContent Class="body-content">
            <FluentStack Class="content" Orientation="Microsoft.FluentUI.AspNetCore.Components.Orientation.Vertical">
                @Body
            </FluentStack>
        </FluentBodyContent>
    </FluentStack>
    <FluentFooter>
        Made with <span class="heart">❤</span> using
        <FluentSpacer Width="5" />
        <a href="https://www.fluentui-blazor.net" target="_blank">Fluent UI Blazor</a>
        . The resume data is based on the
        <FluentSpacer Width="5" />
        <a href="https://jsonresume.org" target="_blank">JSON Resume</a>
        <FluentSpacer Width="5" />
        standard.
        <FluentSpacer />
        <a href="https://learn.microsoft.com/en-us/aspnet/core/blazor" target="_blank">About Blazor</a>
    </FluentFooter>
</FluentLayout>
