@page "/skills"
@inject ResumeDataService ResumeDataService

<PageTitle>Skills</PageTitle>

@if (resume is null)
{
    <FluentStack Class="resume-page" Orientation="Orientation.Vertical">
        <FluentStack Class="resume-card" Orientation="Orientation.Vertical">
            <FluentLabel>Loading skills...</FluentLabel>
        </FluentStack>
    </FluentStack>
}
else
{
    <FluentStack Class="resume-page" Orientation="Orientation.Vertical">
    <FluentStack Class="resume-heading" Orientation="Orientation.Vertical">
        <FluentLabel Class="resume-eyebrow">Skills</FluentLabel>
        <h1>Technical strengths</h1>
        <FluentLabel Class="resume-summary">Skills are grouped directly from the JSON resume and surfaced with their related keywords.</FluentLabel>
    </FluentStack>

    <FluentStack Class="skills-grid" Orientation="Orientation.Horizontal">
        @foreach (var skill in resume.Skills ?? [])
        {
            <FluentStack Class="resume-card" Orientation="Orientation.Vertical">
                <FluentStack Class="timeline-header" Orientation="Orientation.Horizontal">
                    <h2>@skill.Name</h2>
                    @if (!string.IsNullOrWhiteSpace(skill.Level))
                    {
                        <FluentBadge Appearance="Appearance.Accent">@skill.Level</FluentBadge>
                    }
                </FluentStack>

                @if (skill.Keywords?.Count > 0)
                {
                    <ul class="resume-list skills-list">
                        @foreach (var keyword in skill.Keywords)
                        {
                            <li>@keyword</li>
                        }
                    </ul>
                }
            </FluentStack>
        }
    </FluentStack>
    </FluentStack>
}

@code {
    private Resume? resume;

    protected override async Task OnInitializedAsync()
    {
        resume = await ResumeDataService.GetResumeAsync();
    }
}